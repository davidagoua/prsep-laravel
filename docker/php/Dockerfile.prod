# Image de production SIGPRO : nginx + PHP-FPM (serversideup/php), dépendances sans outils de dev,
# assets compilés. La même image sert l'application, le worker de files et Reverb.

# 1. Dépendances PHP
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction --ignore-platform-reqs
COPY . .
RUN composer dump-autoload --optimize --no-dev

# 2. Assets (Vite). Les variables VITE_* sont figées dans le JavaScript à la compilation.
#    VITE_REVERB_APP_KEY est la clé publique Reverb (livrée au navigateur), pas un secret.
FROM node:22-slim AS assets
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
COPY --from=vendor /app/vendor ./vendor
ARG VITE_APP_NAME=SIGPRO
ARG VITE_REVERB_APP_KEY
ARG VITE_REVERB_HOST
ARG VITE_REVERB_PORT=443
ARG VITE_REVERB_SCHEME=https
RUN npm run build

# 3. Image finale
FROM serversideup/php:8.3-fpm-nginx-alpine
USER root
RUN install-php-extensions intl gd bcmath exif pcntl
COPY docker/php/php.ini /usr/local/etc/php/conf.d/zz-sigpro.ini
USER www-data
WORKDIR /var/www/html
COPY --chown=www-data:www-data . .
COPY --chown=www-data:www-data --from=vendor /app/vendor ./vendor
COPY --chown=www-data:www-data --from=assets /app/public/build ./public/build

# Au démarrage : migrations, caches de configuration, routes, vues et événements.
ENV AUTORUN_ENABLED=true \
    PHP_OPCACHE_ENABLE=1 \
    PHP_UPLOAD_MAX_FILE_SIZE=50M \
    PHP_POST_MAX_SIZE=55M \
    PHP_MEMORY_LIMIT=512M \
    SSL_MODE=off
