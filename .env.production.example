# Production — copier en .env sur le serveur et remplir les valeurs entre <>.
APP_NAME=SIGPRO
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<sigpro.domaine.ci>
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Domaines servis par Caddy (HTTPS automatique) et adresse de contact Let's Encrypt
APP_DOMAIN=<sigpro.domaine.ci>
COLLABORA_DOMAIN=<collabora.domaine.ci>
GEOSERVER_DOMAIN=<geoserver.domaine.ci>
ACME_EMAIL=<admin@domaine.ci>

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgis
DB_PORT=5432
DB_DATABASE=sigpro
DB_USERNAME=sigpro
DB_PASSWORD=<mot de passe long>

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379

# Messagerie (invitations, notifications)
MAIL_MAILER=smtp
MAIL_HOST=<smtp.domaine.ci>
MAIL_PORT=587
MAIL_USERNAME=<utilisateur>
MAIL_PASSWORD=<mot de passe>
MAIL_FROM_ADDRESS=<sigpro@domaine.ci>
MAIL_FROM_NAME="SIGPRO"

# Temps réel : le serveur PHP publie vers Reverb en interne ; le navigateur se connecte en wss://APP_DOMAIN.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=<identifiant>
REVERB_APP_KEY=<clé>
REVERB_APP_SECRET=<secret>
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Collabora Online
COLLABORA_URL=https://<collabora.domaine.ci>
COLLABORA_INTERNAL_URL=http://collabora:9980
COLLABORA_WOPI_HOST=http://app:8080
COLLABORA_ADMIN_USER=admin
COLLABORA_ADMIN_PASSWORD=<mot de passe>

# GeoServer
GEOSERVER_URL=https://<geoserver.domaine.ci>/geoserver
GEOSERVER_INTERNAL_URL=http://geoserver:8080/geoserver
GEOSERVER_WORKSPACE=sigpro
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=<mot de passe>

# Premier administrateur (créé par « php artisan db:seed --force »)
SIGPRO_ADMIN_EMAIL=<admin@domaine.ci>
SIGPRO_ADMIN_PASSWORD=
